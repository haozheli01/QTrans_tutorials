#
#      File Name      
#

System.CurrrentDirectory         ./    # default=./
System.Name                   crystal
DATA.PATH                     /public/home/lihaozhe/software/openmx/openmx3.9/DFT_DATA19   # default=../DFT_DATA19
level.of.stdout                   1    # default=1 (1-3)
level.of.fileout                  1    # default=1 (0-2)
HS.fileout                   on       # on|off, default=off

#
# SCF or Electronic System
#

scf.XcType                  GGA-PBE    # LDA|LSDA-CA|LSDA-PW|GGA-PBE
scf.partialCoreCorrection   on 
scf.SpinPolarization        on        # On|Off|NC
scf.ElectronicTemperature  300.0       # default=300 (K) # 2321.0 = 0.2 eV
scf.energycutoff           200.0       # default=150 (Ry)
scf.maxIter                 300         # default=40
scf.EigenvalueSolver       Band    # DC|GDC|Cluster|Band
scf.Kgrid                  22 22 22       # means 4x4x4
scf.Mixing.Type           rmm-diis     # Simple|Rmm-Diis|Gr-Pulay|Kerker|Rmm-Diisk
scf.Init.Mixing.Weight     0.0010      # default=0.30 
scf.Min.Mixing.Weight      0.0001      # default=0.001 
scf.Max.Mixing.Weight      0.3000      # default=0.40 
scf.Mixing.History           50
scf.Mixing.StartPulay        30
scf.Mixing.EveryPulay        1
scf.criterion             1.0e-10      # default=1.0e-6 (Hartree)


#
# Definition of Atomic Species
#
Species.Number       1
<Definition.of.Atomic.Species
Fe   Fe5.5H-s3p2d1       Fe_PBE19H
Definition.of.Atomic.Species>

#
# Atoms
#
Atoms.Number           1
Atoms.SpeciesAndCoordinates.Unit   Ang # Ang|AU
<Atoms.SpeciesAndCoordinates           # Unit=Ang.
  1  Fe   0.0000000   0.0000000   0.0000000   10.00  6.00 on
Atoms.SpeciesAndCoordinates>
Atoms.UnitVectors.Unit             Ang #  Ang|AU
<Atoms.UnitVectors                     # unit=Ang.
      -1.4157935   1.4157935   1.4157935
       1.4157935  -1.4157935   1.4157935
       1.4157935   1.4157935  -1.4157935
Atoms.UnitVectors>

